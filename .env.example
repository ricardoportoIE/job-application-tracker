# Application
APP_NAME=Job Application Tracker API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker_dev@localhost:5432/jobtracker
TEST_DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker_dev@localhost:5432/jobtracker_test
# Used only by the container startup migration process in production.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Authentication
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO

# Required in production. Prometheus clients send it as a bearer token.
METRICS_BEARER_TOKEN=

# API documentation
DOCS_ENABLED=true
