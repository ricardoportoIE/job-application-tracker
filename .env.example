APP_NAME=Job Application Tracker API
APP_VERSION=0.1.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker_dev@localhost:5432/jobtracker
TEST_DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker_dev@localhost:5432/jobtracker_test

JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
